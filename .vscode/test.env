# Test-run environment for the VS Code Python extension (python.envFile).
# Loaded ONLY by the extension's test runs — terminal pytest is unaffected
# (the repo-root conftest.py loads .env, not this file).
#
# Neo4j integration mode: run the neo4j-bound suites (incremental reindex,
# cpp_sqlite_integration, enrichment round-trip) with the test container.
# Remove/comment the line below to return to the fast sqlite default.
CODEGRAPH_BACKEND=neo4j
