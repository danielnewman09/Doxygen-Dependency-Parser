# Test-run environment for the VS Code Python extension (python.envFile).
# Loaded ONLY by the extension's test runs — terminal pytest is unaffected
# (the repo-root conftest.py loads .env, not this file).
#
# Default mode: sqlite — no Docker.  The full pipeline (incl. the
# cpp_sqlite_integration suite) runs against the sqlite backend since the
# Phase-2 backend decoupling made the write path backend-agnostic.
# For the Neo4j opt-in runs, set CODEGRAPH_BACKEND=neo4j here and start
# the test container (tests/docker-compose.yml).
CODEGRAPH_BACKEND=sqlite

# Debug stage tracing for slow-integration root-cause (temporary).
CODEGRAPH_DEBUG=1
